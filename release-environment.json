{
  "schemaVersion": 1,
  "required": [
    "ROBO_LLM_CONFIG",
    "ROBO_LLM_API_KEY",
    "LLM_PROVIDER",
    "LLM_MODEL",
    "OPENAI_BASE_URL",
    "OPENAI_API_KEY",
    "AUTH_ENFORCE"
  ],
  "credentialNames": [
    "ROBO_LLM_API_KEY",
    "ROBO_EMBED_API_KEY",
    "ROBO_SEARCH_LLM_API_KEY",
    "LLM_API_KEY",
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_AUTH_TOKEN",
    "GOOGLE_API_KEY",
    "PARSER_REPAIR_AGENT_API_KEY",
    "PDF2BPMN_FACADE_KEY",
    "AUTH_JWT_SECRET",
    "AUTH_ROLE_SECRET",
    "AUTH_DEV_LOGIN_PASSWORD"
  ],
  "placeholderValues": [
    "notused",
    "changeme",
    "your-api-key",
    "your-api-key-here",
    "sk-your-api-key-here"
  ],
  "forbiddenValuePatterns": [
    {
      "pattern": "ai-server\\.dream-flow\\.com",
      "reason": "개발사 사내 GPU 엔드포인트 — 고객 환경에서 닿지 않는다"
    },
    {
      "pattern": "frentis-ai-model",
      "reason": "개발사 사내 모델 배포명 — 고객 게이트웨이에는 없다"
    },
    {
      "pattern": "qwen38_sglang_local",
      "reason": "개발사 사내 GPU 를 가리키는 LLM 설정 이름"
    }
  ],
  "scopes": {
    "analyzer": {
      "file": "config/analyzer.env",
      "prefixes": [
        "ROBO_LLM_",
        "ROBO_EMBED_",
        "ROBO_SEARCH_",
        "ROBO_CACHE_",
        "ROBO_AGENT_",
        "ROBO_BUDGET_",
        "ROBO_PIPELINE_",
        "ROBO_CATALOG_",
        "ROBO_RUNTIME_",
        "ROBO_SEM_",
        "ROBO_GLOSSARY_"
      ],
      "names": [
        "ROBO_RUN_OUTPUT_DIR",
        "ROBO_NEO4J_RETRY_MAX_ATTEMPTS",
        "ROBO_NEO4J_RETRY_BACKOFF_SECONDS"
      ]
    },
    "catalog": {
      "file": "config/catalog.env",
      "prefixes": [
        "LLM_",
        "EMBEDDING_",
        "FK_",
        "METADATA_",
        "CATALOG_"
      ],
      "names": [
        "OPENAI_API_KEY"
      ]
    },
    "fabric": {
      "file": "config/fabric.env",
      "excludeNames": [
        "MINDSDB_URL",
        "MINDSDB_HOST",
        "MINDSDB_API_PORT"
      ],
      "prefixes": [
        "MINDSDB_",
        "DATA_FABRIC_"
      ],
      "names": [
        "OPENAI_API_KEY"
      ]
    },
    "parser": {
      "file": "config/parser.env",
      "prefixes": [
        "PARSER_",
        "JAVA_"
      ],
      "names": []
    },
    "gateway": {
      "file": "config/gateway.env",
      "prefixes": [
        "GATEWAY_",
        "SPRING_"
      ],
      "names": []
    },
    "pdf2bpmn": {
      "file": "config/pdf2bpmn.env",
      "prefixes": [],
      "names": [
        "LLM_BASE_URL",
        "LLM_MODEL",
        "OPENAI_API_KEY",
        "OPENAI_BASE_URL",
        "OPENAI_MODEL",
        "FACADE_API_KEY"
      ]
    },
    "architect": {
      "file": "architect/app/.env",
      "prefixes": [
        "AUTH_",
        "LLM_",
        "OPENAI_",
        "ANTHROPIC_",
        "GOOGLE_",
        "CHANGE_PROPAGATION_",
        "GENERATION_",
        "INGESTION_",
        "AI_AUDIT_",
        "MODEL_",
        "CHAT_",
        "WIREFRAME_",
        "HYBRID_",
        "PDF2BPMN_",
        "SMART_LOGGER_"
      ],
      "names": [
        "IS_SKIP_UI_PHASE",
        "BC_SPEC_SPLIT_LINE_THRESHOLD"
      ]
    }
  }
}

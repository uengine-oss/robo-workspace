ROBO_LLM_CONFIG=gpt54_mini_openai
ROBO_LLM_API_KEY=fixture-internal-key
ROBO_LLM_MODEL_RUNTIME_CAPABILITIES_REF=llm/capabilities/gpt54_mini_2026_09_01.yaml
ROBO_LLM_MODEL_RUNTIME_CAPABILITIES_SHA256=aab8ef6d022b31481991cb94029043cd19521a0c9a18e7a4e0879caf593896f3
ROBO_EMBED_MODEL=text-embedding-3-small
ROBO_SEARCH_DENSE_IMPL=index
ROBO_PIPELINE_MAX_CONCURRENCY=64
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1
LLM_MAX_OUTPUT_TOKENS=8000
LLM_MAX_COMPLETION_TOKENS=4096
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=fixture-internal-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=fixture-internal-key
MINDSDB_URL=http://host.docker.internal:47334
ROBO_DATASOURCE_REPLACE_LOCALHOST=host.docker.internal
DATA_FABRIC_QUERY_TIMEOUT_SECONDS=30
PARSER_REPAIR_AGENT_ENABLED=false
CHANGE_PROPAGATION_ENABLED=true
HYBRID_EMBED_TOP_K=3
WIREFRAME_LLM_CONCURRENCY=4
# 납품본 모양으로 둔다 — 관문이 실제로 거는 조건을 이 픽스처가 통과해야
# "릴리스가 구워진다" 를 이 테스트가 대변할 수 있다. 18a8a99 가 AUTH 관문을
# 더하면서 여기를 안 채워, 테스트가 5일간 빨간 채였다.
AUTH_ENFORCE=true
AUTH_PROVIDER=swp
# ⚠ provider=swp 면 관문이 **AUTH_CALLBACK_ALLOWLIST 를 요구한다**(2026-10-29).
#    비우면 loopback 만 허용되어 현장 콜백이 거부된다. 이름에 SWP_ 가 안 붙는다.
AUTH_CALLBACK_ALLOWLIST=https://robo.fixture.invalid/auth/callback
# SWP 등록값 — 관문은 비어 있으면 **경고**한다(코드에 기본값이 있어 거절은 아니다).
# 픽스처를 납품본 모양으로 두려면 함께 채운다. 값은 fixture 용 가짜다.
SWP_SSO_REDIRECT_URL=https://sso.fixture.invalid/redirect.jsp?redir_url=
SWP_SSO_VALID_CHECK_URL=https://sso.fixture.invalid/isValidSSO.jsp
SWP_SSO_LOGIN_URL=https://sso.fixture.invalid
SWP_IDX_ID=0
SWP_IDX_EMPNO=1
SWP_IDX_DISPLAYNAME=8
SWP_IDX_MAIL=9
SWP_IDX_DEPT=4
SWP_EMAIL_FALLBACK_DOMAIN=fixture.invalid
AUTH_JWT_SECRET=fixture-internal-key
AUTH_ROLE_SECRET=fixture-internal-key

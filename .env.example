# Copy this file to .env. Workspace is the single environment source for
# development profiles and the internal Electron release.
#
# IMPORTANT: `robo.cmd release architect-electron` places the scoped LLM/API
# values below inside the installer so another internal user can run it
# immediately. Do not use a credential that may be distributed externally.

# App-owned Neo4j ignores these values in the packaged installer and generates
# its own password. Development profiles use them directly.
ROBO_NEO4J_URI=bolt://127.0.0.1:7687
ROBO_NEO4J_USER=neo4j
ROBO_NEO4J_PASSWORD=
ROBO_NEO4J_DATABASE=neo4j

# Analyzer generation LLM — internal Qwen/SGLang GPU server.
ROBO_LLM_CONFIG=qwen36_sglang_local
ROBO_LLM_API_KEY=
ROBO_LLM_REPETITION_GUARD=true
ROBO_LLM_RESPONSE_CACHE=true
ROBO_LLM_RESPONSE_CACHE_MAX_MB=512

# Shared OpenAI-compatible settings used by Architect and Catalog.
LLM_PROVIDER=openai
LLM_MODEL=frentis-ai-model
LLM_MAX_OUTPUT_TOKENS=8000
LLM_API_BASE=http://ai-server.dream-flow.com:30000/v1
LLM_API_KEY=
OPENAI_BASE_URL=http://ai-server.dream-flow.com:30000/v1
OPENAI_API_KEY=

# Analyzer runtime policy.
ROBO_AGENT_CONTEXT_EDITING_TRIGGER_TOKENS=80000
ROBO_AGENT_SCAN_MAX_CALLS=30
ROBO_AGENT_RESIDUAL_MAX_CALLS=15
ROBO_AGENT_SCAN_REGEX_MIN_OP_RATIO=0.5
ROBO_BUDGET_RUN_USD=20
ROBO_CACHE_ENABLED=true
ROBO_CATALOG_ENABLED=true
ROBO_CATALOG_TIMEOUT_SECONDS=120
ROBO_NEO4J_RETRY_MAX_ATTEMPTS=5
ROBO_NEO4J_RETRY_BACKOFF_SECONDS=2
ROBO_PIPELINE_BIG_CONTEXT_THRESHOLD_TOKENS=1000
ROBO_PIPELINE_MAX_CONCURRENCY=64
ROBO_PIPELINE_RESIDUAL_SAMPLE_SIZE=30
ROBO_PIPELINE_RESIDUAL_MAX_ROUNDS=3
ROBO_PIPELINE_BATCH_MAX_TOKENS=1500
ROBO_PIPELINE_EMBED_ENABLED=true
ROBO_RUNTIME_EVENT_FILE_ENABLED=true
ROBO_RUNTIME_EVENT_LEVEL=INFO
ROBO_RUN_OUTPUT_DIR=/data/logs

# Analyzer embedding/search use the same internal GPU endpoint unless
# explicitly overridden.
ROBO_EMBED_API_BASE=http://ai-server.dream-flow.com:30000/v1
ROBO_EMBED_API_KEY=
ROBO_SEARCH_LLM_CONFIG=qwen36_sglang_local
ROBO_SEARCH_LLM_API_KEY=

# Development-only MindsDB endpoint. The packaged installer ignores this
# topology value and uses its app-owned MindsDB container.
MINDSDB_URL=http://host.docker.internal:47334

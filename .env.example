# 이 파일을 .env로 복사합니다. Workspace는 통합 개발 실행과 내부 Electron
# 릴리스의 단일 환경 입력입니다. 비밀 값은 이 예제나 Git에 커밋하지 마십시오.
#
# `robo.cmd release architect-electron`은 필요한 값만 서비스별 snapshot으로 나눠
# 설치본에 포함합니다. 따라서 API credential이 들어간 설치본은 내부 배포물입니다.

# ---------------------------------------------------------------------------
# Workspace / Neo4j (개발 실행 전용)
# ---------------------------------------------------------------------------
# 설치판 Neo4j는 Electron이 별도 비밀번호와 Docker volume으로 관리하므로 아래
# 개발용 접속값은 설치본에 복사되지 않습니다.
ROBO_NEO4J_URI=bolt://127.0.0.1:7687
ROBO_NEO4J_USER=neo4j
ROBO_NEO4J_PASSWORD=
ROBO_NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# Analyzer 생성 LLM - 검증된 사내 Qwen/SGLang GPU 기준
# ---------------------------------------------------------------------------
# 분석기가 쓸 LLM 설정 파일 이름 — robo-data-analyzer 의 `llm/configs/<이름>.yaml`.
#   gpt54_mini_openai   OpenAI 본점 (현재 기준)
#   pgpt                사내 P-GPT 게이트웨이 (**전환 예정**. 게이트웨이의 model slug 를
#                       확인한 뒤 바꾼다 — 본점 이름을 그대로 두면 404)
#   qwen38_sglang_local 개발사 사내 GPU. **납품 환경에서는 쓰지 않는다**
ROBO_LLM_CONFIG=gpt54_mini_openai
ROBO_LLM_API_KEY=
ROBO_LLM_REPETITION_GUARD=true
ROBO_LLM_RESPONSE_CACHE=true
ROBO_LLM_RESPONSE_CACHE_REQUIRE_HIT=false
ROBO_LLM_MODEL_RUNTIME_CAPABILITIES_REF=llm/capabilities/qwen38_sglang_2026_09_01.yaml
ROBO_LLM_MODEL_RUNTIME_CAPABILITIES_SHA256=aab8ef6d022b31481991cb94029043cd19521a0c9a18e7a4e0879caf593896f3
ROBO_LLM_RESPONSE_CACHE_MAX_MB=512

# Analyzer pipeline / observability
ROBO_BUDGET_RUN_USD=20
ROBO_PIPELINE_MAX_CONCURRENCY=64
ROBO_PIPELINE_LLM_MAX_CONCURRENCY=32
ROBO_PIPELINE_BATCH_MAX_TOKENS=1500
ROBO_PIPELINE_EMBED_ENABLED=true
ROBO_CATALOG_ENABLED=true
# ROBO_CATALOG_BASE_URL=http://127.0.0.1:15503/robo
ROBO_CATALOG_TIMEOUT_SECONDS=120
# ROBO_CATALOG_TEST_DATASOURCE=
ROBO_NEO4J_RETRY_MAX_ATTEMPTS=5
ROBO_NEO4J_RETRY_BACKOFF_SECONDS=2
ROBO_RUNTIME_EVENT_FILE_ENABLED=true
ROBO_RUNTIME_EVENT_LEVEL=INFO
ROBO_RUN_OUTPUT_DIR=/data/logs
# ROBO_DATA_DIR=../project/data

# Analyzer embedding / semantic search
# provider 는 openai / sglang / local. `openai` 는 **`text-embedding-*` 모델만** 받는다
# (robo-data-analyzer 의 `llm/text_embedder.py` 가 기동 전에 막는다).
#
# **여기를 바꾸면 벡터 공간이 바뀐다.** 질의와 노드가 같은 공간에 있는지는
# `provider:model` 지문으로 대조하므로, 이미 만들어 둔 임베딩은 다시 만들어야 한다.
ROBO_EMBED_PROVIDER=openai
ROBO_EMBED_MODEL=text-embedding-3-small
ROBO_EMBED_API_BASE=https://api.openai.com/v1
ROBO_EMBED_API_KEY=
ROBO_EMBED_CONCURRENCY=8
ROBO_EMBED_CHAR_BUDGET=700
ROBO_EMBED_MAX_RETRIES=6
ROBO_EMBED_TIMEOUT_SECONDS=180
ROBO_SEARCH_LLM_CONFIG=gpt54_mini_openai
ROBO_SEARCH_LLM_API_KEY=
ROBO_SEARCH_DENSE_IMPL=index
ROBO_SEARCH_FETCH_K=100
ROBO_SEARCH_SELECTION=global_anchor
ROBO_SEARCH_ANCHOR_TOP=3
ROBO_SEARCH_SUPPORT_ROOT_TOP=12
ROBO_SEARCH_EVIDENCE_TOP=15
ROBO_SEARCH_ANCHOR_GAP=0.12
ROBO_SEARCH_SUPPORT_POLICY=graph_gated
ROBO_SEARCH_DIRECT_GAP=0.12
ROBO_SEARCH_HOP_GATE=3
ROBO_SEARCH_RANK_FLOOR=2
ROBO_SEARCH_CE_TOP=15
ROBO_SEARCH_REWRITE=novel_abbrev

# ---------------------------------------------------------------------------
# Architect + Catalog 공용 OpenAI-compatible GPU
# ---------------------------------------------------------------------------
# 현재 기준은 OpenAI 본점이고, **이후 사내 P-GPT 게이트웨이로 바뀐다.**
# 바꿀 때 `LLM_MODEL`·`OPENAI_MODEL` 을 게이트웨이가 노출하는 slug 로 같이 바꾼다 —
# 본점 이름을 그대로 두면 404 다.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Architect는 전역 출력 상한, Catalog는 completion 상한을 각각 읽습니다.
LLM_MAX_OUTPUT_TOKENS=8000
LLM_MAX_COMPLETION_TOKENS=4096
LLM_READ_TIMEOUT_S=120
LLM_TOKENIZER_FALLBACK=tiktoken
MODEL_KWARGS={"temperature":0.3}
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1
# CHAT_MODEL=gpt-4.1
# LLM_VISION_MODEL=

# 다른 provider를 선택할 때만 채웁니다.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
GOOGLE_API_KEY=

# Catalog
EMBEDDING_MODEL=text-embedding-3-small
# CATALOG_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CATALOG_ALLOW_NEO4J_HEADER_OVERRIDE=false
CATALOG_DISCOVERY_SNAPSHOT_TTL_SECONDS=900
CATALOG_DISCOVERY_SNAPSHOT_CAPACITY=256
FK_INFERENCE_ENABLED=true
FK_SAMPLE_SIZE=25
FK_SIMILARITY_THRESHOLD=0.8
FK_MATCH_RATIO_THRESHOLD=0.8
FK_CONCURRENCY=5
METADATA_TIMEOUT_CONNECT=5
METADATA_TIMEOUT_REQUEST=30
# DATA_FABRIC_URL=http://127.0.0.1:8404

# ---------------------------------------------------------------------------
# Data Fabric / MindsDB
# ---------------------------------------------------------------------------
DATA_FABRIC_QUERY_TIMEOUT_SECONDS=30
# DATA_FABRIC_HOST=0.0.0.0
# DATA_FABRIC_PORT=8404
# DATA_FABRIC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DATA_FABRIC_ALLOW_NEO4J_HEADER_OVERRIDE=false
MINDSDB_REPLACE_LOCALHOST=host.docker.internal

# 개발용 endpoint입니다. 설치판은 app-owned MindsDB container 주소를 강제합니다.
MINDSDB_URL=http://host.docker.internal:47334
# MINDSDB_HOST=127.0.0.1
# MINDSDB_API_PORT=47334

# ---------------------------------------------------------------------------
# ANTLR Parser - 기본은 결정론적 복구만 사용
# ---------------------------------------------------------------------------
PARSER_REPAIR_APPLY_TO_SOURCE=false
PARSER_REPAIR_AGENT_ENABLED=false
# PARSER_REPAIR_AGENT_API_BASE=https://api.openai.com/v1
# PARSER_REPAIR_AGENT_MODEL=gpt-4.1
# PARSER_REPAIR_AGENT_API_KEY=
PARSER_REPAIR_AGENT_TIMEOUT_SECONDS=120
PARSER_REPAIR_AGENT_MAX_OUTPUT_TOKENS=2048
# PARSER_REPAIR_AGENT_REASONING_EFFORT=
# PARSER_REPAIR_AGENT_THINKING_ENABLED=
# PARSER_REPAIR_AGENT_TOP_K=

# ---------------------------------------------------------------------------
# Architect 기능 설정
# ---------------------------------------------------------------------------
CHANGE_PROPAGATION_ENABLED=true
CHANGE_PROPAGATION_MAX_ROUNDS=4
CHANGE_PROPAGATION_MAX_CONFIRMED=60
CHANGE_PROPAGATION_MAX_NEW_PER_ROUND=20
CHANGE_PROPAGATION_MAX_FRONTIER_PER_ROUND=8
CHANGE_PROPAGATION_CONFIRMED_THRESHOLD=0.70
CHANGE_PROPAGATION_REVIEW_THRESHOLD=0.40
CHANGE_PROPAGATION_REL_WHITELIST=IMPLEMENTS,HAS_AGGREGATE,HAS_COMMAND,EMITS,HAS_POLICY,TRIGGERS,INVOKES

INGESTION_BATCH_SIZE=500
INGESTION_SNAPSHOT_DEBUG=0
INGESTION_CACHE_DEFAULT=1
GENERATION_LANGUAGE_DEFAULT=en-US
AI_AUDIT_LOG_ENABLED=true
AI_AUDIT_LOG_FULL_PROMPT=false
AI_AUDIT_LOG_FULL_OUTPUT=false
IS_SKIP_UI_PHASE=false
MODEL_MODIFIER_CONTEXT_CHARS_LIMIT=100000
BC_SPEC_SPLIT_LINE_THRESHOLD=800

# Architect wireframe / hybrid ingestion 고급 설정
WIREFRAME_LLM_CONCURRENCY=4
WIREFRAME_LLM_TIMEOUT_SEC=300
# WIREFRAME_SERVICE_URL=http://127.0.0.1:7610
# WIREFRAME_SERVICE_VARIANT=
HYBRID_EMBEDDING_MODEL=text-embedding-3-small
HYBRID_EMBED_THETA_AUTO=0.5
HYBRID_EMBED_THETA_REVIEW=0.4
HYBRID_EMBED_TOP_K=3
HYBRID_ES_FN_DF_THRESHOLD=0.5
HYBRID_GLOSSARY_NORMALIZE=1
HYBRID_GLOSSARY_MAX_RECOVERIES=4
HYBRID_LEXICAL_MIN_HITS=2
HYBRID_LEXICAL_MAX_TOKEN_DF=0.35
HYBRID_PASSAGE_TOP_K=2
HYBRID_PASSAGE_THETA=0.5
HYBRID_USE_A2A=true
# HYBRID_A2A_DUMP_DIR=/tmp/hybrid_a2a_raw
# HYBRID_PUBLIC_BASE_URL=http://127.0.0.1:8501
# PDF2BPMN_A2A_URL=http://127.0.0.1:9999
PDF2BPMN_A2A_TIMEOUT_S=300
# PDF2BPMN_FACADE_URL 은 여기서 채우지 않습니다 — 설치판은 pdf2bpmn 컨테이너를
# 띄우면서 Electron 이 그 루프백 주소를 직접 주입합니다(포트가 설치마다 다릅니다).
PDF2BPMN_FACADE_TIMEOUT_S=600
# PDF2BPMN_FACADE_KEY=
# PDF2BPMN_SHARED_PDF_DIR=/tmp/hybrid_a2a_pdfs

# --- pdf2bpmn 컨테이너(문서 -> BPMN) 자체 설정 -------------------------------
# config/pdf2bpmn.env 로 포장되어 컨테이너에 들어갑니다. 사내망에서는
# LLM_BASE_URL 을 P-GPT 로 채우십시오. 비우면 컨테이너가 api.openai.com 으로
# 나가려다 막힙니다. 그때 **오류는 안 납니다** — Architect 가 폴백으로 내려가
# 화면에는 그대로 BPM 이 나오므로, 이 컨테이너가 놀고 있다는 걸 아무도 모릅니다.
# 비워 두면 OPENAI_BASE_URL 을 대신 씁니다.
LLM_BASE_URL=
# 컨테이너는 127.0.0.1 에만 열리므로 보통 비워 둡니다. 채우려면 Architect 쪽
# PDF2BPMN_FACADE_KEY 와 **같은 값**이어야 합니다.
FACADE_API_KEY=
# SMART_LOGGER_BLACKLIST_MESSAGES=
# ODA_KNOWLEDGE_ROOT=

# Gateway의 ROBO_* URL, API/서비스 포트, Neo4j, ROBO_DATA_DIR 및 설치판
# ROBO_CLUSTER_MCP_URL/ROBO_SPEC_BACKEND_URL은 Workspace/Electron이 topology에
# 맞춰 직접 주입하므로 이 파일에서 설정하지 않습니다.
# ROBO_ANTLR_URL=http://127.0.0.1:8401
# ROBO_ANALYZER_URL=http://127.0.0.1:15502
# ROBO_CATALOG_URL=http://127.0.0.1:15503
# ROBO_DATA_FABRIC_URL=http://127.0.0.1:8404
# ROBO_ARCHITECT_URL=http://127.0.0.1:8501
# ROBO_CLUSTER_MCP_URL=http://127.0.0.1:15502/robo/mcp/
# ROBO_SPEC_BACKEND_URL=http://127.0.0.1:8501
# API_HOST=127.0.0.1
# API_PORT=8501

# ── 인증 (Architect) ────────────────────────────────────────────────────────
# 이 절이 없으면 **설치본에 인증을 켤 방법이 없다.** release-environment.json 의
# architect 범위가 `AUTH_` 접두사를 포장하므로, 여기 적은 값이 설치본의
# architect/app/.env 로 옮겨진다.

# 인증을 강제하는가. **이 키는 값이 비면 release 가 실패한다** — false 라도
# 적어야 한다. 끄면 로그인 화면이 아예 안 뜨고 기존처럼 X-User-* 헤더로 돈다.
AUTH_ENFORCE=false

# 로그인 방식. none = 헤더 기반(로그인 화면 없음) · swp(별칭 posco) = 사내 SSO.
# **AUTH_ENFORCE=true 로만 켜면 SSO 뿐이라 오프라인 환경에서는 들어갈 수 없다.**
AUTH_PROVIDER=none
# AUTH_CALLBACK_ALLOWLIST=

# 세션 토큰의 서명 비밀. **AUTH_ENFORCE=true 면 반드시 채운다.**
# 비워 두면 앱이 죽지 않고 임시 비밀로 발급한다 — 그래서 조용하다. 대신
# 재기동마다 모든 세션이 끊기고, AUTH_ROLE_SECRET 이 비어 있으면 role
# 비밀번호가 이 값에서 유도되므로 **graph 연결까지 함께 죽는다.**
AUTH_JWT_SECRET=
# AUTH_SESSION_TTL_SECONDS=28800

# role 비밀번호의 씨앗. 비우면 AUTH_JWT_SECRET 에서 유도한다(위 주의 참고).
AUTH_ROLE_SECRET=

# 사용자별 graph 권한으로 연결을 묶는다. 켜면 권한 없는 graph 가 안 열린다.
AUTH_BIND_CONNECTION=false
# AUTH_BIND_CACHE_SECONDS=15
# AUTH_APPROVAL_REQUIRED=

# ⚠ 개발용 우회 로그인. **켠 상태로 release 를 돌리면 관문이 막는다** —
# id/password 로 무조건 들어오는 문이고 기본값이 test/test 다.
# 설치본에서 화면을 밟아 봐야 하면 **설치된 architect/app/.env 에서만** 켠다.
AUTH_DEV_LOGIN_ENABLED=false
# AUTH_DEV_LOGIN_ID=test
# AUTH_DEV_LOGIN_PASSWORD=test
# AUTH_DEV_LOGIN_EMPNO=DEV-TEST
# AUTH_DEV_LOGIN_NAME=개발용 계정
# AUTH_DEV_LOGIN_ALLOW_REMOTE=false
